{
  "name": "wigaj-web-platform",
  "private": true,
  "version": "3.1.3",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "preview": "next start --hostname 127.0.0.1",
    "typecheck": "tsc -b",
    "typecheck:storybook": "tsc -p tsconfig.storybook.json",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:imports": "node scripts/check-imports.mjs",
    "check": "npm run check:local && npm run typecheck && npm run typecheck:storybook && npm run build && npm run build-storybook",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "generate:page": "node scripts/create-page.mjs",
    "generate:ui": "node scripts/create-ui.mjs",
    "test:unit": "node --no-warnings --experimental-strip-types --test tests/*.test.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:ui-kit": "node scripts/check-ui-kit.mjs",
    "check:ui-ownership": "node scripts/check-ui-ownership.mjs",
    "check:local": "npm run check:architecture && npm run check:imports && npm run check:feature-exports && npm run check:syntax && npm run check:styles && npm run check:ui-kit && npm run check:ui-ownership && npm run check:components && npm run test:unit",
    "check:styles": "node scripts/check-styles.mjs",
    "check:feature-exports": "node scripts/check-feature-exports.mjs",
    "check:components": "node scripts/check-component-usage.mjs"
  },
  "dependencies": {
    "lenis": "^1.3.25",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "overlayscrollbars": "^2.16.0",
    "overlayscrollbars-react": "^0.5.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "@storybook/addon-a11y": "10.5.5",
    "@storybook/addon-docs": "10.5.5",
    "@storybook/react-vite": "10.5.5",
    "storybook": "10.5.5"
  },
  "overrides": {
    "nanoid": "3.3.18"
  },
  "engines": {
    "node": ">=20.16.0 <21 || >=22.19.0 <23 || >=24.0.0"
  },
  "packageManager": "npm@10.9.2"
}
