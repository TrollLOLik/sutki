# Keep this file aligned with the root .gitignore. EAS archives from the Git
# root even though the app itself lives in /mobile.
/tmp
/out-tsc
/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
/.pnp
.pnp.js

.vscode/*
.idea/
.gemini/
/_to_delete/
.cache/
.gocache/
.pnpm-store/
/deploy/.env.production

# Independent services and documentation are not required to build Android.
/backend/
/centrifugo/
/deploy/
/docs/
/pages_maket/
/public_html/

# Local tooling scratch files.
/.agents/
/.codex-temp/

# Mobile dependencies are restored from mobile/package-lock.json.
/mobile/node_modules/

# Expo and generated output.
/mobile/.expo/
/mobile/.expo-export-check/
/mobile/dist/
/mobile/web-build/
/mobile/builds/

# Native projects are generated by Expo prebuild during the managed build.
/mobile/android/
/mobile/ios/
/mobile/.kotlin/

# Local mobile caches and editor state.
/mobile/.cache/
/mobile/.codex-temp/
/mobile/.vscode/
/mobile/*.tsbuildinfo
/mobile/*.log
/mobile/example/

# Local secrets must be configured in the EAS production environment.
/mobile/.env
/mobile/.env*.local

# Signing material must never be uploaded from the working tree.
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.pem
